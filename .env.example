# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5. Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_MODEL=
# Optional: model for the small yes/no check on unanswered group messages (defaults to CLAUDE_MODEL)
CLAUDE_MODEL_LIGHT=
# The agents stop using AI for the day once this many US dollars are spent (0 = no limit)
AI_DAILY_BUDGET_USD=5

# Whapi.Cloud channel tokens: one channel per WhatsApp number
WHAPI_OPS_TOKEN=          # the number that sits in customer groups
WHAPI_SALES_TOKEN=        # the number that talks to prospects

# Long random string; it is part of the webhook URL you give Whapi:
#   https://agents.unispire.ae/webhooks/whapi/ops/<WEBHOOK_SECRET>
#   https://agents.unispire.ae/webhooks/whapi/sales/<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# Must equal ENQUIRY_WEBHOOK_SECRET on the website (website ENQUIRY_WEBHOOK_URL = https://agents.unispire.ae/webhooks/enquiry)
ENQUIRY_WEBHOOK_SECRET=

PORT=8787
# DRY_RUN=1 logs messages instead of sending them
DRY_RUN=
